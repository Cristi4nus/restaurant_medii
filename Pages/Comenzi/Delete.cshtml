@page
@model restaurant_medii.Pages.Comenzi.DeleteModel

<h1>Delete</h1>

<h3>Sigur vrei să ștergi această comandă?</h3>

<p><strong>Client:</strong> @Model.Comanda.Client.NumeComplet</p>
<p><strong>Data:</strong> @Model.Comanda.DataComenzii.ToShortDateString()</p>
<p><strong>Total:</strong> @Model.Comanda.Total lei</p>

<form method="post">
    <input type="hidden" asp-for="Comanda.ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
