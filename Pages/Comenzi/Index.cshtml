@page
@model restaurant_medii.Pages.Comenzi.IndexModel

<h1>Comenzi</h1>

<p><a asp-page="Create">Create New</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Client</th>
            <th>Data</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Comanda)
        {
            <tr>
                <td>@item.Client.NumeComplet</td>
                <td>@item.DataComenzii.ToShortDateString()</td>
                <td>@item.Total lei</td>
                <td>
                    <a asp-page="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
