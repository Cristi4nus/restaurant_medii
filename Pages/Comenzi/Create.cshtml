@page
@model restaurant_medii.Pages.Comenzi.CreateModel

<h1>Create</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Comanda.ClientID"></label>
        <select asp-for="Comanda.ClientID" class="form-control" asp-items="ViewBag.ClientID"></select>
    </div>

    <div class="form-group">
        <label>Produse</label>
        <select asp-for="SelectedProduseIDs"
                class="form-control"
                multiple="multiple"
                asp-items="Model.ProduseItems">
        </select>
    </div>

    <div class="form-group">
        <label>Cantitate implicită</label>
        <input asp-for="CantitateImplicita" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Comanda.DataComenzii"></label>
        <input asp-for="Comanda.DataComenzii" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<a asp-page="Index">Back to List</a>
