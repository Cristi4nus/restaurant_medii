@page
@model restaurant_medii.Pages.Comenzi.DetailsModel

<h1>Detalii Comandă</h1>

<p><strong>Client:</strong> @Model.Comanda.Client.NumeComplet</p>
<p><strong>Data:</strong> @Model.Comanda.DataComenzii.ToShortDateString()</p>

<h3>Produse</h3>
<table class="table">
    <thead>
        <tr>
            <th>Produs</th>
            <th>Pret</th>
            <th>Cantitate</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cp in Model.Comanda.ProduseComanda)
        {
            <tr>
                <td>@cp.Produs.Nume</td>
                <td>@cp.Produs.Pret lei</td>
                <td>@cp.Cantitate</td>
                <td>@(cp.Cantitate* cp.Produs.Pret) lei</td>
            </tr>
        }
    </tbody>
</table>

<h3>Total: @Model.Comanda.Total lei</h3>

<a asp-page="Index">Back to List</a>
