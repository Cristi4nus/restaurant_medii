@page "{id:int?}"
@model restaurant_medii.Pages.Categorii.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Categorie[0].Nume)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model.Categorie)
        {
            string selectedRow = "";
            if (item.ID == Model.CategorieID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Nume)
                </td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>

@if (Model.CategorieData.Produse != null)
{
    <h3>Produse din categoria selectată</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Nume Produs</th>
                <th>Preț</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var produs in Model.CategorieData.Produse)
            {
                <tr>
                    <td>@produs.Nume</td>
                    <td>@produs.Pret</td>
                </tr>
            }
        </tbody>
    </table>
}
