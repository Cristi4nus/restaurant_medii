@page "/"
@model restaurant_medii.Pages.Produse.IndexModel

@{
    ViewData["Title"] = "Produse";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Caută după nume produs / categorie:
            <input type="text" name="stringCautare" value="@Model.NumeCautare" />
            <input type="submit" value="Search" class="btn btn-primary" /> |
            <a asp-page="./Index">Back to full list</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Produs[0].Nume)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Produs[0].Pret)
            </th>

            <th>
                <a asp-page="./Index" asp-route-produsSortare="@Model.CategorieSortare">
                    @Html.DisplayNameFor(model => model.Produs[0].Categorie.Nume)
                </a>
            </th>

            <th>
                <a asp-page="./Index" asp-route-produsSortare="@Model.AlergenSortare">
                    Alergeni
                </a>
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>

@foreach (var item in Model.ProdusD.Produse)
{
    string selectedRow = "";
    if (item.ID == Model.ProdusID)
    {
        selectedRow = "table-success";
    }

    <tr class="@selectedRow">
        <td>
            @item.Nume
        </td>

        <td>
            @item.Pret
        </td>

        <td>
            @item.Categorie.Nume
        </td>

        <td>
            @foreach (var alergen in item.AlergeniProduse)
            {
                @alergen.Alergen.NumeAlergen <br />
            }
        </td>

        <td>
            <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
            <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
            <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
        </td>
    </tr>
}

    </tbody>
</table>
