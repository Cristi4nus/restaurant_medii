@page
@model restaurant_medii.Pages.Produse.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Produs</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Produs.ID" />
            <div class="form-group">
                <label asp-for="Produs.Nume" class="control-label"></label>
                <input asp-for="Produs.Nume" class="form-control" />
                <span asp-validation-for="Produs.Nume" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Produs.Pret" class="control-label"></label>
                <input asp-for="Produs.Pret" class="form-control" />
                <span asp-validation-for="Produs.Pret" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Categorie</label>
                <select asp-for="Produs.CategorieID" class="form-control"
                        asp-items="Model.CategoriiSelectList"></select>
                <span asp-validation-for="Produs.CategorieID" class="text-danger"></span>
            </div>
            <div class="form-group">
            <div class="table">
                <table>
                    <tr>
                        @{
                            int cnt = 0;
                            foreach (var alergen in Model.AlergeniAtribuitiList)
                            {
                                if (cnt++ % 3 == 0)
                                {
                                    @:</tr><tr>
                                }
                                @:<td>
                                    <input type="checkbox"
                                           name="selectedAlergeni"
                                           value="@alergen.AlergenID"
                                           @(Html.Raw(alergen.Atribuit ? "checked=\"checked\"" : "")) />
                                    @alergen.AlergenID @: @alergen.Nume
                                @:</td>
                            }
                            @:</tr>
                        }
                </table>
            </div>
        </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
